:root{--azul:#1769d2;--claro:#f3f7fc}body{background:#fff;color:#172b4d}.navbar-brand{font-size:1.45rem}.hero{background:var(--claro);border-radius:22px;padding:3rem}.hero-placeholder{height:260px;border-radius:18px;background:linear-gradient(135deg,#dbeafe,#eff6ff);display:grid;place-items:center;color:#1769d2;font-size:1.4rem;font-weight:700}.product-card{height:100%;border:1px solid #e8edf4;border-radius:16px;overflow:hidden;transition:.2s}.product-card:hover{transform:translateY(-4px);box-shadow:0 12px 30px #15294b12}.product-card img{height:190px;width:100%;object-fit:cover;background:#f1f4f8}.product-placeholder{height:190px;background:#edf2f8;display:grid;place-items:center;color:#8392a8}.price{font-size:1.15rem;font-weight:700;color:var(--azul)}.footer{background:#f5f7fa;border-top:1px solid #e8edf4}.detail-image{width:100%;max-height:440px;object-fit:cover;border-radius:18px;background:#f1f4f8}.detail-panel{background:#f8fafc;border-radius:18px;padding:2rem}.detail-label{color:#64748b;font-size:.85rem;margin-bottom:.2rem}.detail-value{font-weight:600;margin-bottom:1rem}@media(max-width:767px){.hero{padding:1.5rem}.hero-placeholder{height:180px}}
